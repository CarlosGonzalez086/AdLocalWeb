---
import PwaHead from "../components/common/PwaHead.astro";
import "../styles/App.css";
import "../styles/sweetalert.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const DEFAULT_TITLE = "AdLocal | Comercios y Servicios Locales en tu Comunidad";
const DEFAULT_DESCRIPTION =
  "Descubre y apoya comercios locales cerca de ti. Encuentra productos artesanales, agenda citas de servicios y realiza pedidos en línea en AdLocal.";
const DEFAULT_OG_IMAGE = new URL("/adlocal-social.png", Astro.url.origin).toString();

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonical,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = "website",
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical || Astro.url.href;
const fullTitle = title.includes("AdLocal") ? title : `${title} | AdLocal`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:site_name" content="AdLocal" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- PWA & Favicon -->
    <PwaHead title={fullTitle} description={description} />

    <!-- Fuentes: Inter & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />

    <!-- Bootstrap 5 CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    />
  </head>
  <body>
    <!-- Accesibilidad: Skip to content -->
    <a
      href="#main-content"
      class="visually-hidden-focusable p-2 bg-white text-dark position-absolute start-0 top-0 z-3 m-2 border rounded fw-semibold shadow-sm"
    >
      Saltar al contenido principal
    </a>

    <div id="main-content" class="w-100 min-vh-100 d-flex flex-column">
      <slot />
    </div>

    <!-- Bootstrap 5 Bundle JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
      defer></script>
  </body>
</html>
