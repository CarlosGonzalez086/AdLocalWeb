---
import ComercioWraper from "../../wrappers/ComercioWraper";

export const prerender = false;
const { slug } = Astro.params;
const parts = slug?.split("_");
const id = Number(slug?.split("_")[0]);
const nombre = parts?.slice(1).join("_").replace(/_/g, " ");

if (isNaN(id)) return Astro.redirect("/");
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{nombre}</title>
    <link
      rel="icon"
      type="image/jpeg"
      sizes="32x32"
      href="https://pub-d5a2e881682f4782a4be2517d547d3c7.r2.dev/logo-comercio-imagen/WhatsApp%20Image%202025-12-23%20at%2021.19.26%20(1).jpeg"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=location_on"
    />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/src/styles/leaflet.css" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style="background-color: #F2F2F7;">
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"></script>
    <ComercioWraper id={id} client:only="react" />
  </body>
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap");

    :root {
      /* Font */
      --font-body:
        "Inter", -apple-system, BlinkMacSystemFont, "SF Pro Display",
        "Segoe UI", sans-serif !important;
    }
    *::before,
    *::after {
      font-family: var(--font-body);
    }
    body {
      font-family: var(--font-body);
      /* height: 100vh;
    width: 100vw;
    overflow: hidden; */
    }
  </style>
</html>
